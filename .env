# 全局基础环境变量配置
VITE_APP_TITLE=休闲游戏与百宝箱
VITE_APP_VERSION=1.0.0

# 登录鉴权控制：true 表示强制未登录拦截并拉起登录页，false 表示允许游客模式
VITE_REQUIRE_LOGIN=true

# 是否开启模拟登录功能（方便开发调试与演示体验）
VITE_ENABLE_MOCK_LOGIN=true

# API 基础接口地址
VITE_API_BASE_URL=https://mock.api.local

# AI 模型与 Agent 接口配置 (兼容 pangxiaoyin_view 的 Agnes / OpenAI 图像与 Agent 接口)
VITE_AI_BASE_URL=https://apihub.agnes-ai.com
VITE_AI_API_KEY=
VITE_AI_IMAGE_MODEL=agnes-image-2.0-flash
VITE_AI_CHAT_MODEL=agnes-2.0-flash
