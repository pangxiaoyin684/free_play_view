# =========================================================================
# 1Panel 部署环境变量配置模板 (free-play-view)
# =========================================================================

# 1. 阿里云 ACR 镜像地址 (默认使用最新版)
APP_IMAGE=crpi-vrso5s2zv7dk1hk1.cn-wulanchabu.personal.cr.aliyuncs.com/pangxiaoyin/free-play-view:latest

# 2. 宿主机对外映射端口 (默认 8080，可按需修改避免端口冲突)
HOST_PORT=8080

# 3. 容器资源保护限制 (防止服务器占用过载)
CPU_LIMIT=1.0
MEMORY_LIMIT=512M
